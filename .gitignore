playwright-report/
# Build output: every `npm run pack` / `store:pack` rewrites these, so committing
# them only grows the repository. dist/README.md stays tracked as the directory note.
dist/*.zip
dist/*.zip.sha256
.env
.env.*
!.env.example
*.log
.DS_Store
Thumbs.db
# Documentation screenshots are regenerated from public fixtures, but they stay
# tracked on purpose: the READMEs render them from the repository.
# English store assets are regenerated by `npm run store:build:en`.
publishing/assets/en-US/
# Local Playwright browser downloads used by the asset builders.
tmp/browsers/
