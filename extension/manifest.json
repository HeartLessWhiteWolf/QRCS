{
  "manifest_version": 3,
  "name": "QRCS 二维码识别",
  "version": "1.0.2",
  "description": "右键识别图片，或点击图标框选网页二维码。本地处理，先预览再跳转。",
  "minimum_chrome_version": "127",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage", "offscreen"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {
    "default_title": "框选二维码 · QRCS",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
